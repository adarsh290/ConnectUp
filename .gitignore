# Root-level gitignore for ConnectUp monorepo

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local

# Frontend-specific (handled in frontend/.gitignore too)
frontend/node_modules/
frontend/build/
frontend/coverage/

# Backend-specific (handled in backend/.gitignore too)
backend/node_modules/
backend/uploads/*
!backend/uploads/.gitkeep
